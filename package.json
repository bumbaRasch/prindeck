{
  "name": "prindeck",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial Linux control panel for the Brother MFC-L2710DW",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bumbaRasch/prindeck.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check:code-language": "bash scripts/check-code-language.sh",
    "check:line-count": "bash scripts/check-line-count.sh",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~7.0.2",
    "vite": "^8.0.16"
  }
