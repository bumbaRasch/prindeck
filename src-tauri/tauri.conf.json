{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prindeck",
  "version": "0.1.0",
  "identifier": "dev.bumbarasch.prindeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "prindeck",
        "width": 900,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "publisher": "Dimitri Pisarev",
    "homepage": "https://github.com/bumbaRasch/prindeck",
    "copyright": "Copyright © 2026 Dimitri Pisarev",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Unofficial Linux control panel for the Brother MFC-L2710DW",
    "longDescription": "prindeck is an unofficial desktop control panel for the Brother MFC-L2710DW on Linux. It shows the device status and supplies over SNMP, scans through eSCL to PDF or JPEG, and sends print jobs through CUPS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/doc/prindeck/copyright": "../LICENSE"
        }
      }
    }
  }
}
